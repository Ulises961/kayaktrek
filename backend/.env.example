# Secret keys — generate each with: python -c "import secrets; print(secrets.token_hex(32))"


# Flask Configuration
CONFIG_MODE=development
FLASK_HOST=0.0.0.0
SECRET_KEY=your-secret-key-here # SECRET_KEY   → Flask session / cookie signing

# Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/kayak_dev
# Separate DB for the test suite — keeps alembic_version clean in the dev DB
TESTING_DATABASE_URL=postgresql://user:password@localhost:5432/kayak_test

#JWT
JWT_SECRET_KEY=your-jwt-secret-key-here # JWT_SECRET_KEY → JWT token signing

# M29 — satellite feed credential encryption (server-decryptable, unattended by the beat task)
FEED_CREDENTIAL_KEY=your-feed-credential-key-here # 64 hex chars (32 bytes)


# Message broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Email (Flask-Mail) — account verification, password reset, GDPR notifications
#
# Production uses **Brevo** as the SMTP relay, not Gmail — the values below are placeholders for
# a local direct run, and the Gmail-shaped defaults are historical. Personal Gmail SMTP was
# replaced on 2026-08-23 for deliverability and its per-day send cap; see DEPLOY.md's "Mail"
# section for the full picture, including why inbound mail is a different provider entirely.
#
# MAIL_DEFAULT_SENDER must be **on the authenticated domain** (e.g. noreply@<domain>), not a
# personal address. Brevo signs for that domain, so a From: header on any other domain fails
# DMARC alignment even though SPF and DKIM are correct — the message is authenticated for a
# domain it does not claim to be from, which is exactly what alignment checks.
#
# NOTE: the docker-compose dev/e2e stack ignores these and pins MAIL_SERVER to the local
# `mailpit` sink (SMTP :1025, web UI http://localhost:8025). That is deliberate — a real
# relay host here must not be able to leak into the e2e suite, which registers users and
# fires alerts at fake addresses and would otherwise post real mail to them. These values
# apply when running the backend directly (`.venv/bin/python wsgi.py`) and in production.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Production transport: Brevo's HTTP API, not SMTP. DigitalOcean blocks outbound SMTP
# (25/465/587) on every droplet, unconditionally — confirmed 2026-09-06, not liftable by a
# support ticket. Setting this switches Services/mail_service.py off SMTP entirely; leave it
# unset here (and everywhere local/dev/CI) to keep using MAIL_SERVER above / mailpit.
# Generate under Brevo > SMTP & API > API Keys — a different credential from MAIL_PASSWORD's
# SMTP key.
# BREVO_API_KEY=

# Postal address rendered in every email footer. Left empty renders no address line at all —
# nothing is faked. Set it once trader identification applies (DSA): a reachable sender is
# both a spam-filter signal and, for a trader, a disclosure. It does not have to be a home
# address; a registered business or forwarding address is what this field is for.
# MAIL_POSTAL_ADDRESS=Kayaktrek, Via Example 1, 00100 Roma RM, Italy

# Frontend URL — base for links in emails (verify, password reset) and the footer's site link
FRONTEND_URL=http://localhost:3000

# Closed-beta registration gate — a single shared code testers must enter to create an
# account. Leave empty/unset to disable the gate entirely (registration works exactly as
# before). Rotate by changing this value and redeploying; there is no admin UI for it.
INVITE_CODE=

# Medical notes (M3g, client-side crypto since M22) — parked 2026-09-02. The code, schema
# and tests all stay; only the hosted surface is closed. Unset/empty (the default, and what
# production runs) 404s all nine medical endpoints and drops them from the OpenAPI contract.
# `true` restores the feature. Set it locally to work on the parked code; docker-compose.yml
# pins it on for the dev and e2e stacks already. See docs/adr/safety-privacy.md "Parked".
MEDICAL_NOTES_ENABLED=

# Hours of position-ping silence on a happening trip's scheduled Day before the
# shore contact is emailed a missed-checkpoint alert; also the re-alert cooldown.
CHECKPOINT_ALERT_HOURS=6

# Redis — four logical databases on the shared instance
# /0 rate limiter · /1 application cache · /2 Celery results backend · /3 live position pub/sub
# Use memory:// for RATELIMIT_STORAGE_URI when running outside Docker without Redis.
#
# maxmemory-policy applies INSTANCE-WIDE, across every logical DB — a DB number is a
# namespace, not an isolation boundary. Everything above is disposable under the shared
# instance's allkeys-lru, so eviction is harmless for all of it. The revoked-session
# denylist is not, and is why the `redis-auth` instance exists (see below). Anything added
# here must survive being evicted at any moment, or it needs its own instance too.
RATELIMIT_STORAGE_URI=memory://
CACHE_REDIS_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
LIVE_REDIS_URL=redis://localhost:6379/3
# The revoked-session denylist runs on its OWN redis instance, not a DB on the shared one.
# The shared instance evicts with allkeys-lru, which applies instance-wide across every
# logical DB and ranks a write-once/read-rarely denylist key as the coldest thing in it —
# so under memory pressure it would silently un-revoke a signed-out device. docker-compose
# points this at the `redis-auth` service; this default is for running against a single
# bare local redis, where nothing sets a maxmemory policy and there is nothing to evict.
REVOCATION_REDIS_URL=redis://localhost:6379/4

# Map-tile proxy cache (Services/tile_cache.py). Local disk, not the object store — the proxy
# re-serves tile bytes through Flask, so the browser never fetches them from R2 and a cache
# hit would otherwise pay a WAN round trip. Unset = a temp directory.
# TILE_CACHE_DIR=/var/cache/kayak/tiles
# Eviction thresholds for the nightly sweep, read by the *worker*. 5 GiB / 10 GiB free.
# Not a cost control: the cache shares a filesystem with Postgres, and a full disk stops
# Postgres writing WAL. 0 disables the size cap but not the free-space floor.
# TILE_CACHE_MAX_BYTES=5368709120
# TILE_CACHE_MIN_FREE_BYTES=10737418240

# Number of trusted reverse-proxy hops in front of this app (e.g. 1 for a single nginx/
# load-balancer in front). Leave at 0 (default) for local/direct-exposure setups — rate
# limiting keys on the peer address, and trusting X-Forwarded-For with 0 hops configured
# would let a client spoof its own IP. Only set this to match your actual deploy topology.
PROXY_TRUSTED_HOPS=0

# Object storage (MinIO locally; swap endpoint/keys for R2 or S3 in production)
# --- Object storage -------------------------------------------------------------------
#
# LOCAL DEV / CI — MinIO, one bucket. These defaults work as-is; nothing below is needed.
# STORAGE_ENDPOINT is the internal Docker URL, STORAGE_PUBLIC_URL is the host a browser
# resolves (they differ because MinIO is reachable at `minio:9000` inside the network and
# at a public hostname outside it).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=kayak
STORAGE_SECRET_KEY=your-minio-password
STORAGE_BUCKET=kayak

# SigV4 needs a region in the signing scope even where the backend has no regions. MinIO
# accepts anything; R2 validates against wnam/enam/weur/eeur/apac/oc/auto and rejects the
# rest with InvalidRegionName, which fails every upload and every presigned URL. `auto` is
# R2's own answer and is fine for MinIO too, so it is the default and rarely needs setting.
# STORAGE_REGION=auto

# PRODUCTION — Cloudflare R2, two buckets. Uncomment and fill in on the box.
#
#   Cloudflare shows you ...................  put it in
#   ---------------------------------------  --------------------------------------------
#   S3 API endpoint                           STORAGE_ENDPOINT *and* STORAGE_PUBLIC_URL
#     https://<account-id>.r2.cloudflarestorage.com
#   Access Key ID                             STORAGE_ACCESS_KEY
#   Secret Access Key                         STORAGE_SECRET_KEY
#   the bucket carrying the custom domain     STORAGE_BUCKET_PUBLIC
#   the other bucket                          STORAGE_BUCKET_PRIVATE
#   https://cdn.kayaktrek.app                 STORAGE_PUBLIC_BASE_URL
#
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=<r2-access-key-id>
# STORAGE_SECRET_KEY=<r2-secret-access-key>
# STORAGE_BUCKET_PUBLIC=kayaktrek-prod-public
# STORAGE_BUCKET_PRIVATE=kayaktrek-prod-private
# STORAGE_PUBLIC_BASE_URL=https://cdn.kayaktrek.app
#
# STORAGE_BUCKET is unused once both split vars are set — it is only the value they fall
# back to. Leave it or delete it; it has no effect either way.
#
# GOTCHA: the S3 API endpoint is ACCOUNT-level, not per-bucket. Each bucket's settings page
# shows https://<account-id>.r2.cloudflarestorage.com/<that-bucket-name>, so two buckets
# look like two endpoints — but they differ only in the trailing bucket name; the hostname
# is identical (put them side by side and everything before the final / matches). Use only
# the part BEFORE the bucket. boto3 appends the bucket itself from the Bucket= parameter,
# so pasting the whole string gives .../bucket/bucket/key and 404s on every object.
#
# One endpoint, one client, both buckets — which is what makes the cross-bucket copy in
# StorageService.move() possible. Likewise create ONE API token scoped to both buckets, with
# Object Read & Write (not Admin): the runtime does object CRUD only, never bucket creation
# or policy writes, and that has been true since M11 §4.
#
# Why one value in two variables: they are different ideas that happen to coincide on R2.
# STORAGE_ENDPOINT is where the backend talks to storage; STORAGE_PUBLIC_URL is the host a
# presigned URL is signed against, which must be one the browser can reach. MinIO has an
# internal and an external hostname; R2 has one endpoint and it is already public.
#
# Why STORAGE_PUBLIC_BASE_URL exists at all: an R2 custom domain maps to a bucket at its
# own root (cdn.kayaktrek.app/avatars/x.jpg — no bucket segment), while MinIO is path-style
# (host/bucket/avatars/x.jpg). The base is configured whole rather than assembled, because
# the two shapes disagree.
#
# Why two buckets: MinIO scopes anonymous read by PREFIX (avatars/ and point-images/ are
# readable, documents/ and point-images-private/ are not). R2 scopes it by BUCKET. Same
# access boundary, so it has to become two buckets to survive the move.
#
# The custom domain goes on the PUBLIC bucket ONLY. Attaching one to the private bucket
# makes it world-readable and would expose every trip document, private route photo and
# GDPR export. The private bucket needs no domain — presigned URLs are signed against the
# account endpoint above, which already resolves.
#
# Use a subdomain MinIO never served (not `storage.`) so both can serve during the
# copy-and-verify window and old URLs stay valid until cutover is confirmed. Objects are
# UUIDv7-keyed and every upload gets a fresh key, so they are effectively immutable — a
# long cache TTL on the custom domain is safe and needs no invalidation.

# MinIO credentials — LOCAL DEV ONLY. MinIO is no longer in docker-compose.prod.yml at all:
# production objects are on R2 and the tile cache moved to local disk, which left the
# container with nothing to serve. Nothing automated needs MinIO either (the storage tests
# mock boto3, and no e2e spec uploads a file) — it exists so that avatars, point photos,
# documents and GDPR exports actually work when you use the app locally.
MINIO_ROOT_USER=kayak
MINIO_ROOT_PASSWORD=your-minio-password

# Logging — leave unset to log to stdout only (recommended in containers)
# Set to a directory path to also write a rotating file (mount a volume at that path)
# LOG_DIR=./var/log

# Set to "true" to enable SQLAlchemy query logging (very verbose — debug sessions only)
# SQL_ECHO=true

# Logfire — distributed tracing (Pydantic's managed OTel backend; docs/adr/foundation.md ADR-009)
# Get a write token at https://logfire.pydantic.dev/. Leave unset to disable: logfire.configure()
# runs with send_to_logfire="if-token-present", so an unset token is a silent no-op — safe in
# CI/tests, no prompt, no error. The JsonFormatter stdout stream is unaffected either way.
LOGFIRE_TOKEN=
