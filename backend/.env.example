# Flask Configuration
CONFIG_MODE=development
FLASK_HOST=0.0.0.0

# Database URLs
DEVELOPMENT_DATABASE_URL=postgresql://user:password@localhost:5432/kayak_trip_planner_dev
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/kayak_trip_planner_test
STAGING_DATABASE_URL=postgresql://user:password@localhost:5432/kayak_trip_planner_staging
PRODUCTION_DATABASE_URL=postgresql://user:password@localhost:5432/kayak_trip_planner_prod

# Secret Keys for JWT - Generate these with: python -c "import secrets; print(secrets.token_hex(32))"
DEVELOPMENT_SECRET_KEY=your-development-secret-key-here
TEST_SECRET_KEY=your-test-secret-key-here
STAGING_SECRET_KEY=your-staging-secret-key-here
PRODUCTION_SECRET_KEY=your-production-secret-key-here

JWT_ACCESS_TOKEN_EXPIRES=3600

# Message broker (RabbitMQ)
# Start locally with: docker compose up rabbitmq  (from the project root)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
