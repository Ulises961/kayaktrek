# Secret keys — generate each with: python -c "import secrets; print(secrets.token_hex(32))"


# Flask Configuration
CONFIG_MODE=development
FLASK_HOST=0.0.0.0
SECRET_KEY=your-secret-key-here # SECRET_KEY   → Flask session / cookie signing

# Database URL 
DATABASE_URL=postgresql://user:password@localhost:5432/kayak_dev

#JWT
JWT_SECRET_KEY=your-jwt-secret-key-here # JWT_SECRET_KEY → JWT token signing


# Message broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Email (Flask-Mail) — account verification and password reset
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend URL — base for links in emails (verify, password reset)
FRONTEND_URL=http://localhost:3000

# Rate limiting
# memory:// for local dev without Redis; redis://redis:6379/0 via docker compose
RATELIMIT_STORAGE_URI=memory://

# Logging — leave unset to log to stdout only (recommended in containers)
# Set to a directory path to also write a rotating file (mount a volume at that path)
# LOG_DIR=./var/log
