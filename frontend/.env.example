NEXT_PUBLIC_API_URL=http://localhost:5000

# The M8 SSE sidecar (ADR-033) — a separate process from the main backend, so a separate
# origin in dev. Both NEXT_PUBLIC_* origins are inlined into the client bundle at build
# time and `lib/api/config.ts` throws on an empty one in a production build, so a
# `next build` fails outright without this — unset is only tolerated by `next dev`.
NEXT_PUBLIC_SSE_URL=http://localhost:5001

# Logfire — distributed tracing (Pydantic's managed OTel backend; docs/adr/foundation.md ADR-009)
# Get a write token at https://logfire.pydantic.dev/. Leave unset to disable: instrumentation.ts's
# register() no-ops with no exporter registered and no network calls — safe in CI/tests/dev
# machines that haven't configured one. Server-side only; no browser RUM (deliberately deferred).
LOGFIRE_TOKEN=

# development | staging | production — tags the deployment.environment.name resource attribute on
# every span. Leave unset to fall back to NODE_ENV.
LOGFIRE_ENVIRONMENT=

# Medical notes (M3g, client-side crypto since M22) — parked 2026-09-02. Unset or anything
# other than `true` hides every medical-notes surface: the profile section, the float-plan
# tab section, the leader's crew-manifest viewer, and the keypair prompt banner. Must match
# the backend's MEDICAL_NOTES_ENABLED — this flag hides the UI, that one closes the API, and
# neither substitutes for the other. Inlined at build time like the other NEXT_PUBLIC_* vars,
# so production images are built without it. See docs/adr/safety-privacy.md "Parked".
NEXT_PUBLIC_MEDICAL_NOTES=true
