# Env file for docker-compose.prod.yml on the deploy target (home box for now, DO after
# ADR-034's graduation trigger). Copy to .env next to docker-compose.prod.yml and fill in.
#
# This is NOT the same file as backend/.env.example (that's for running the backend
# outside Docker) or frontend/.env.local — NEXT_PUBLIC_API_URL/NEXT_PUBLIC_SSE_URL are
# baked into the frontend image at build time (frontend-ci.yml, from repo Variables), not
# read from this file at deploy time. See DEPLOY.md.
#
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

CONFIG_MODE=production

# --- Postgres ---
POSTGRES_USER=kayak
POSTGRES_PASSWORD=
POSTGRES_DB=kayak_prod

# --- RabbitMQ ---
RABBITMQ_USER=kayak
RABBITMQ_PASSWORD=

# --- Flask / JWT ---
SECRET_KEY=
JWT_SECRET_KEY=

# --- Redis — defaults already point at the `redis` service/DB split used by
# docker-compose.prod.yml; only override if you need something different. ---
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
# CACHE_REDIS_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# LIVE_REDIS_URL=redis://redis:6379/3

# --- Logfire — distributed tracing (ADR-009). Leave unset to disable (silent no-op). ---
LOGFIRE_TOKEN=

# --- Email (Flask-Mail) — verification, password reset, checkpoint/GDPR notifications ---
# Brevo (brevo.com), not Gmail — a personal/dedicated Gmail account still sends as a
# @gmail.com-family address, which doesn't look legitimate as a product sender even with a
# dedicated account. Brevo is EU-headquartered (Paris), SMTP-compatible (no app code
# changes), and free up to 300 emails/day.
# MAIL_USERNAME is the Brevo account login email; MAIL_PASSWORD is an SMTP key generated
# under Brevo > SMTP & API > SMTP, not your Brevo account password. MAIL_DEFAULT_SENDER
# must be a domain you've verified in Brevo (SPF/DKIM records) — same domain as
# FRONTEND_URL below once Cloudflare Tunnel (ADR-034 point 3) is set up.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Public URLs — required in prod (no localhost fallback); used in email links and by
# the frontend to fetch objects. Until Cloudflare Tunnel + a domain exist (ADR-034 point
# 3), point these at whatever address the box is actually reachable at during testing. ---
FRONTEND_URL=
STORAGE_PUBLIC_URL=

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=kayak
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET=kayak

# --- Missed-checkpoint shore-contact alert cadence (hours) ---
CHECKPOINT_ALERT_HOURS=6

# --- Reverse-proxy hop count for ProxyFix. The box's host-level nginx is already one
# hop in front of this, so 1 is correct even before Cloudflare Tunnel exists — bump to
# 2 once Tunnel (ADR-034 point 3) is added in front of nginx too. ---
PROXY_TRUSTED_HOPS=1
