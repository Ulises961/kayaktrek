# Env file for docker-compose.prod.yml on the deploy target (home box for now, DO after
# ADR-034's graduation trigger). Copy to .env next to docker-compose.prod.yml and fill in.
#
# This is NOT the same file as backend/.env.example (that's for running the backend
# outside Docker) or frontend/.env.local — NEXT_PUBLIC_API_URL/NEXT_PUBLIC_SSE_URL are
# baked into the frontend image at build time (frontend-ci.yml, from repo Variables), not
# read from this file at deploy time. See DEPLOY.md.
#
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

CONFIG_MODE=production

# --- Postgres ---
POSTGRES_USER=kayak
POSTGRES_PASSWORD=
POSTGRES_DB=kayak_prod

# --- RabbitMQ ---
RABBITMQ_USER=kayak
RABBITMQ_PASSWORD=

# --- Flask / JWT ---
SECRET_KEY=
JWT_SECRET_KEY=

# --- Redis — defaults already point at the `redis` service/DB split used by
# docker-compose.prod.yml; only override if you need something different. ---
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
# CACHE_REDIS_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# LIVE_REDIS_URL=redis://redis:6379/3
# REVOCATION_REDIS_URL=redis://redis:6379/4

# --- Logfire — distributed tracing (ADR-009). Leave unset to disable (silent no-op). ---
LOGFIRE_TOKEN=

# --- Email — verification, password reset, checkpoint/GDPR notifications ---
# Brevo (brevo.com), not Gmail — a personal/dedicated Gmail account still sends as a
# @gmail.com-family address, which doesn't look legitimate as a product sender even with a
# dedicated account. Brevo is EU-headquartered (Paris), and free up to 300 emails/day.
#
# BREVO_API_KEY is the ACTUAL transport in production — DigitalOcean blocks outbound SMTP
# (25/465/587) on every droplet, unconditionally (confirmed 2026-09-06, not liftable by a
# support ticket), so MAIL_USERNAME/MAIL_PASSWORD below never reach Brevo from this box.
# Generate it under Brevo > SMTP & API > API Keys — a different credential from the SMTP key.
# The MAIL_* SMTP vars stay set anyway: they're what local dev and CI/testing use against
# mailpit, and Services/mail_service.py falls back to them if BREVO_API_KEY is ever unset.
BREVO_API_KEY=
# MAIL_USERNAME is the Brevo account login email; MAIL_PASSWORD is an SMTP key generated
# under Brevo > SMTP & API > SMTP, not your Brevo account password. MAIL_DEFAULT_SENDER
# must be a domain you've verified in Brevo (SPF/DKIM records) — same domain as
# FRONTEND_URL below once Cloudflare Tunnel (ADR-034 point 3) is set up.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Public URLs — required in prod (no localhost fallback); used in email links and by
# the frontend to fetch objects. Until Cloudflare Tunnel + a domain exist (ADR-034 point
# 3), point these at whatever address the box is actually reachable at during testing. ---
FRONTEND_URL=
STORAGE_PUBLIC_URL=

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=kayak
MINIO_ROOT_PASSWORD=
STORAGE_BUCKET=kayak

# --- Missed-checkpoint shore-contact alert cadence (hours) ---
CHECKPOINT_ALERT_HOURS=6

# --- Reverse-proxy hop count for ProxyFix. The box's host-level nginx is already one
# hop in front of this, so 1 is correct even before Cloudflare Tunnel exists — bump to
# 2 once Tunnel (ADR-034 point 3) is added in front of nginx too. ---
PROXY_TRUSTED_HOPS=1

# --- Encrypted offsite backups (scripts/backup-db.sh, run from host cron) -------------
#
# Backblaze B2, deliberately NOT Cloudflare: once objects live in R2, Cloudflare holds
# primary data, and a database dump beside them means one account suspension takes out
# both the data and the ability to restore it. Two copies in one account are not two
# backups.
#
# The application key must be scoped to THIS BUCKET ONLY, with listFiles + readFiles +
# writeFiles and NOT deleteFiles. Retention is a B2 lifecycle rule applied server-side, so
# nothing here ever deletes — which is what stops a compromised box erasing the backup
# history. readFiles is needed because rclone checks the destination before uploading, and
# by the restore path; listFiles because the upload is verified afterwards. See DEPLOY.md.
# B2's S3-compatible endpoint for the bucket's region, e.g.
# https://s3.eu-central-003.backblazeb2.com — shown on the bucket's page in the B2 console.
# The S3 API rather than B2's native one because rclone's native `b2` backend always tries
# to create the bucket if it cannot see it, with no way to disable that; a key scoped to one
# bucket cannot create buckets, so every upload 401s.
BACKUP_B2_ENDPOINT=
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
BACKUP_B2_BUCKET=

# The age PUBLIC key (starts `age1...`). This box holds only the public half, so it can
# write backups it cannot itself read — a compromised server does not hand over the
# backup history with it. Generate with `age-keygen`, put the PRIVATE half in your
# password manager (and consider a printed copy: it is one line, and you need it exactly
# once, on the worst day). It is never stored on this machine. Lose it and every backup
# is unrecoverable — that is the trade for the property above.
BACKUP_AGE_RECIPIENT=

# Optional: also keep a local copy in this directory. Empty/0 = offsite only.
BACKUP_RETAIN_LOCAL=0
