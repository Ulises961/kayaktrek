# Inlined into the client bundle at build time (see lib/api/config.ts) — the RN
# equivalent of frontend's NEXT_PUBLIC_*. Unset in a production build fails loudly.
#
# Android emulators can't reach the host machine via localhost — use 10.0.2.2 instead.
# A physical device needs the host's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:5000
# The SSE sidecar (live trip-change notifications). Same emulator/device rules as above.
EXPO_PUBLIC_SSE_URL=http://localhost:5001
