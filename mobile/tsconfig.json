{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    // frontend/tsconfig.json's own "@/*": ["./*"] alias — needed here too because tsc
    // type-checks frontend/lib/**/*.ts files directly as part of mobile's program
    // (Metro's watchFolders proof, plans/M9a.md WP5), and those files use `@/...`
    // imports internally (e.g. frontend/lib/itinerary/distance.ts -> "@/lib/dtos/point").
    // Without this mapping tsc resolves `@/*` relative to mobile/, not frontend/.
    "paths": {
      "@/*": ["../frontend/*"]
    }
  }
}
