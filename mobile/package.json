    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest-expo": "^57.0.4",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:run": "jest",
    "generate:theme": "node --experimental-strip-types scripts/generate-theme-css.js"
